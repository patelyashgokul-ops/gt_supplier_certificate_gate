<odoo>
  <record id="purchase.group_purchase_user" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_user'))]"/></record>
  <record id="view_purchase_certificate_gate" model="ir.ui.view"><field name="name">purchase.order.certificate.gate</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_gt_check_certificates" type="object" string="Check Certificates" invisible="state not in ['draft','sent','to approve']"/></xpath><xpath expr="//notebook" position="inside"><page string="Certificate Check" name="gt_certificate_check"><p>This is the last explicitly requested check, not purchase authorization. Confirmation and final approval always check current requirements again.</p><group><field name="gt_checked_at"/><field name="gt_check_result"/></group><field name="gt_check_summary" nolabel="1"/></page></xpath></field></record>
</odoo>
