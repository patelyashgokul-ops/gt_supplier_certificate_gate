<odoo>
  <record id="view_policy_list" model="ir.ui.view"><field name="name">gt.certificate.policy.list</field><field name="model">gt.certificate.policy</field><field name="arch" type="xml"><list><field name="company_id"/><field name="lead_days"/><field name="owner_id"/></list></field></record>
  <record id="view_policy_form" model="ir.ui.view"><field name="name">gt.certificate.policy.form</field><field name="model">gt.certificate.policy</field><field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="lead_days"/><field name="owner_id"/></group><p>Lead time defaults to 30 calendar days. Business dates use the company partner timezone, with UTC as fallback. A default owner must be an active Certificate User authorized for this company.</p></sheet></form></field></record>
  <record id="action_policy" model="ir.actions.act_window"><field name="name">Renewal Policies</field><field name="res_model">gt.certificate.policy</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_policy" name="Renewal Policies" parent="menu_config" action="action_policy" groups="group_manager" sequence="20"/>
  <record id="view_renewal_list" model="ir.ui.view"><field name="name">gt.certificate.renewal.list</field><field name="model">gt.certificate.renewal</field><field name="arch" type="xml"><list create="0" delete="0" decoration-danger="overdue" decoration-muted="state in ['covered','cancelled']"><field name="supplier_id"/><field name="company_id"/><field name="type_id"/><field name="expiry"/><field name="expiry_bucket"/><field name="owner_id"/><field name="due_date"/><field name="state"/><field name="overdue"/><field name="unassigned"/><field name="activity_ids" widget="list_activity"/></list></field></record>
  <record id="view_renewal_form" model="ir.ui.view"><field name="name">gt.certificate.renewal.form</field><field name="model">gt.certificate.renewal</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_refresh" type="object" string="Refresh Renewal" groups="group_manager"/><button name="action_request_followup" type="object" string="Request Another Follow-up" groups="group_manager" invisible="state in ['covered','cancelled']"/><field name="state" widget="statusbar"/></header><sheet><group><field name="company_id" readonly="1"/><field name="supplier_id" readonly="1"/><field name="type_id" readonly="1"/><field name="expiry"/><field name="owner_id"/><field name="due_date"/><field name="overdue"/><field name="unassigned"/><field name="activity_acknowledged"/></group><p>Completing an Activity acknowledges follow-up only. It does not approve evidence or resolve the requirement. Only effective verified coverage beyond the reminder window resolves this cycle. Purchase actions always re-evaluate current evidence.</p></sheet><chatter/></form></field></record>
  <record id="view_renewal_search" model="ir.ui.view"><field name="name">gt.certificate.renewal.search</field><field name="model">gt.certificate.renewal</field><field name="arch" type="xml"><search><field name="supplier_id"/><field name="company_id"/><field name="type_id"/><field name="owner_id"/><filter name="open" string="Open Renewals" domain="[('state','not in',['covered','cancelled'])]"/><filter name="mine" string="My Renewals" domain="[('owner_id','=',uid)]"/><filter name="unassigned" string="Unassigned" domain="[('unassigned','=',True)]"/><filter name="overdue" string="Overdue Follow-ups" domain="[('overdue','=',True)]"/><separator/><filter name="expired" string="Expired" domain="[('expiry_bucket','=','expired')]"/><filter name="seven" string="Expiring Within 7 Days" domain="[('expiry_bucket','=','7')]"/><filter name="thirty" string="Expiring Within 30 Days" domain="[('expiry_bucket','in',['7','30'])]"/><filter name="supplier" string="Awaiting Supplier" domain="[('state','=','supplier')]"/><filter name="review" string="Pending Review" domain="[('state','=','review')]"/><filter name="future" string="Future Approved" domain="[('state','=','future')]"/></search></field></record>
  <record id="action_renewal" model="ir.actions.act_window"><field name="name">Pending Renewals</field><field name="res_model">gt.certificate.renewal</field><field name="view_mode">list,form</field><field name="context">{'search_default_open': 1}</field></record>
  <menuitem id="menu_renewal" name="Pending Renewals" parent="menu_root" action="action_renewal" sequence="25"/>
</odoo>
