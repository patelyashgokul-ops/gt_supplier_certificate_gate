<odoo>
  <record id="action_dashboard" model="ir.actions.client"><field name="name">Supplier Compliance Dashboard</field><field name="tag">gt_supplier_certificate_gate.dashboard</field></record>
  <menuitem id="menu_dashboard" name="Dashboard" parent="menu_root" action="action_dashboard" sequence="1" groups="gt_supplier_certificate_gate.group_user"/>
  <record id="view_blocked_list" model="ir.ui.view"><field name="name">purchase.order.current.certificate.blockers</field><field name="model">purchase.order</field><field name="arch" type="xml"><list create="0" decoration-danger="gt_current_status == 'blocked'"><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="user_id"/><field name="state"/><field name="gt_current_status"/><field name="gt_current_details"/><field name="gt_checked_at" optional="hide"/></list></field></record>
  <record id="action_blocked_live" model="ir.actions.server"><field name="name">Currently Blocked Purchase Orders</field><field name="model_id" ref="purchase.model_purchase_order"/><field name="state">code</field><field name="code">action = env['gt.certificate.dashboard'].open_kpi('blocked')</field></record>
  <menuitem id="menu_blocked_live" name="Blocked Purchase Orders" parent="menu_root" action="action_blocked_live" sequence="30" groups="purchase.group_purchase_user"/>
  <record id="action_coverage_live" model="ir.actions.server"><field name="name">Certificate Expiry and Coverage</field><field name="model_id" ref="model_gt_supplier_certificate"/><field name="state">code</field><field name="code">action = env['gt.certificate.dashboard'].open_kpi('coverage')</field></record>
  <menuitem id="menu_coverage_live" name="Certificate Expiry Report" parent="menu_root" action="action_coverage_live" sequence="35" groups="gt_supplier_certificate_gate.group_user"/>
  <record id="view_coverage_list" model="ir.ui.view"><field name="name">gt.certificate.coverage.report.list</field><field name="model">gt.certificate.coverage.report</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="supplier_id"/><field name="company_id"/><field name="type_id"/><field name="status"/><field name="expiry"/><field name="owner_id"/><field name="work_id"/><field name="evaluated_at"/><button name="action_orders" type="object" string="Current Blocked POs" icon="fa-shopping-cart" groups="purchase.group_purchase_user"/><button name="action_certificates" type="object" string="Certificate Versions" icon="fa-files-o"/></list></field></record>
  <record id="view_coverage_form" model="ir.ui.view"><field name="name">gt.certificate.coverage.report.form</field><field name="model">gt.certificate.coverage.report</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_orders" type="object" string="Current Blocked POs" groups="purchase.group_purchase_user"/><button name="action_certificates" type="object" string="Certificate Versions"/></header><sheet><p>This read-only projection reflects the evaluation timestamp. Return to the dashboard and refresh to recalculate. Purchase confirmation always performs its own current check.</p><group><field name="supplier_id"/><field name="company_id"/><field name="type_id"/><field name="status"/><field name="expiry"/><field name="owner_id"/><field name="evaluated_at"/><field name="work_id"/></group><field name="category_ids" widget="many2many_tags"/><field name="order_ids" widget="many2many_tags" groups="purchase.group_purchase_user"/></sheet></form></field></record>
  <record id="view_coverage_search" model="ir.ui.view"><field name="name">gt.certificate.coverage.report.search</field><field name="model">gt.certificate.coverage.report</field><field name="arch" type="xml"><search><field name="supplier_id"/><field name="type_id"/><field name="company_id"/><field name="owner_id"/><filter name="uncovered" string="Not Currently Covered" domain="[('status','!=','effective')]"/><group><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/><filter name="group_supplier" string="Supplier" context="{'group_by':'supplier_id'}"/><filter name="group_owner" string="Owner" context="{'group_by':'owner_id'}"/><filter name="group_status" string="Coverage Status" context="{'group_by':'status'}"/></group></search></field></record>
  <record id="view_certificate_live_details" model="ir.ui.view"><field name="name">purchase.order.live.certificate.details</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//page[@name='gt_certificate_check']" position="inside"><group string="Current Evaluation" groups="gt_supplier_certificate_gate.group_user"><field name="gt_current_status"/><field name="gt_current_details"/></group></xpath></field></record>
  <record id="view_certificate_readonly_submitted" model="ir.ui.view"><field name="name">gt.supplier.certificate.finalized.readonly</field><field name="model">gt.supplier.certificate</field><field name="inherit_id" ref="view_certificate_form"/><field name="arch" type="xml"><xpath expr="//sheet/group/field[@name='reference' or @name='company_id' or @name='supplier_id' or @name='type_id' or @name='valid_from' or @name='valid_until']" position="attributes"><attribute name="readonly">state != 'draft'</attribute></xpath></field></record>
  <record id="view_renewal_grouping" model="ir.ui.view"><field name="name">gt.certificate.renewal.workload.search</field><field name="model">gt.certificate.renewal</field><field name="inherit_id" ref="view_renewal_search"/><field name="arch" type="xml"><xpath expr="//search" position="inside"><group><filter name="group_owner" string="Renewal Owner" context="{'group_by':'owner_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/><filter name="group_state" string="Renewal Status" context="{'group_by':'state'}"/></group></xpath></field></record>
  <record id="view_pending_verification_list" model="ir.ui.view"><field name="name">gt.supplier.certificate.pending.verification</field><field name="model">gt.supplier.certificate</field><field name="priority">60</field><field name="arch" type="xml"><list create="0"><field name="reference"/><field name="supplier_id"/><field name="company_id"/><field name="type_id"/><field name="submitted_at"/><field name="submitter_id"/><field name="valid_from"/><field name="valid_until"/><field name="owner_id"/><field name="state"/></list></field></record>
  <record id="action_review" model="ir.actions.act_window"><field name="view_id" ref="view_pending_verification_list"/></record>
</odoo>
