<templates xml:space="preserve">
<t t-name="gt_supplier_certificate_gate.Dashboard">
  <main class="gt-dashboard" aria-label="Supplier compliance dashboard" t-att-aria-busy="state.loading ? 'true' : 'false'">
    <header class="gt-heading"><div><span class="gt-brand">GOLOK TECHNOLOGY <span> / SUPPLIER CERTIFICATES</span></span><h1>Supplier Compliance Dashboard</h1><p>Know what needs attention. Keep purchasing moving with verified evidence.</p></div><button class="btn gt-refresh" t-on-click="load" t-att-disabled="state.loading"><i class="fa fa-refresh me-2" aria-hidden="true"/>Refresh</button></header>
    <t t-if="state.data">
      <section class="gt-filters" aria-label="Dashboard filters">
        <label>Company<select name="company_id" t-on-change="changeFilter" t-att-value="state.filters.company_id"><option value="0">All authorized companies</option><option t-foreach="state.data.options.companies" t-as="o" t-key="o.id" t-att-value="o.id" t-esc="o.name"/></select></label>
        <label>Renewal owner<select name="owner_id" t-on-change="changeFilter" t-att-value="state.filters.owner_id"><option value="0">All owners</option><option t-if="state.data.can_manage" value="unassigned">Unassigned</option><option t-foreach="state.data.options.owners" t-as="o" t-key="o.id" t-att-value="o.id" t-esc="o.name"/></select></label>
        <label>Supplier<select name="supplier_id" t-on-change="changeFilter" t-att-value="state.filters.supplier_id"><option value="0">All relevant suppliers</option><option t-foreach="state.data.options.suppliers" t-as="o" t-key="o.id" t-att-value="o.id" t-esc="o.name"/></select></label>
        <label>Certificate type<select name="type_id" t-on-change="changeFilter" t-att-value="state.filters.type_id"><option value="0">All certificate types</option><option t-foreach="state.data.options.types" t-as="o" t-key="o.id" t-att-value="o.id" t-esc="o.name"/></select></label>
        <label>Product category<select name="category_id" t-on-change="changeFilter" t-att-value="state.filters.category_id"><option value="0">All categories</option><option t-foreach="state.data.options.categories" t-as="o" t-key="o.id" t-att-value="o.id" t-esc="o.name"/></select></label>
        <label>Expiry window<select name="window" t-on-change="changeFilter" t-att-value="state.filters.window"><option value="all">All dates and gaps</option><option value="7">Covered · next 7 days</option><option value="30">Covered · next 30 days</option><option value="60">Covered · next 60 days</option><option value="policy">Company reminder window</option></select></label>
        <label>Certificate status<select name="status" t-on-change="changeFilter" t-att-value="state.filters.status"><option value="all">All statuses</option><option value="effective">Currently covered</option><option value="missing">Missing</option><option value="expired">Expired</option><option value="future">Not yet effective</option><option value="pending">Has pending submission</option><option value="rejected">Has rejected submission</option><option value="revoked">Has revoked evidence</option><option value="draft">Has unverified draft</option></select></label>
        <button class="btn btn-link" t-on-click="clearFilters">Clear filters</button>
      </section>
      <div class="gt-freshness"><span class="gt-live-dot" aria-hidden="true"/>Calculated on request <time t-esc="state.data.updated_at"/> UTC <span class="gt-scope-note">Current gate failures, not historical confirmation attempts.</span></div>
      <section class="gt-kpis" aria-label="Compliance indicators"><button t-foreach="cards" t-as="card" t-key="card.key" t-att-class="'gt-kpi gt-tone-' + card.tone" t-on-click="() => this.open(card.key)" t-att-disabled="state.data.kpis[card.key] === null"><span class="gt-kpi-top"><span t-esc="card.label"/><i t-att-class="'fa ' + card.icon" aria-hidden="true"/></span><strong t-esc="state.data.kpis[card.key] === null ? 'Unavailable' : state.data.kpis[card.key]"/><small t-esc="state.data.kpis[card.key] === null ? 'Purchase Order read permission required' : card.unit"/><span class="gt-card-link">View records <i class="fa fa-arrow-right" aria-hidden="true"/></span></button></section>
      <section class="gt-analytics"><article class="gt-panel gt-chart"><div class="gt-panel-title"><div><h2>Certificate coverage horizon</h2><p>One supplier / company / type per bucket. Overlapping history counts once.</p></div><button class="btn btn-link" t-on-click="() => this.open('coverage')">Expiry report <i class="fa fa-arrow-right" aria-hidden="true"/></button></div><p class="gt-chart-description">Missing effective evidence includes pending, future, rejected, revoked and unverified requirements. Continuous verified coverage beyond 60 days is excluded from this chart.</p><div class="gt-bars" role="list" aria-label="Certificate expiry buckets"><button t-foreach="state.data.chart" t-as="bar" t-key="bar.key" class="gt-bar-row" role="listitem" t-on-click="() => this.open(bar.key)" t-att-aria-label="bar.label + ': ' + bar.count + ' coverage relationships. View records.'"><span t-esc="bar.label"/><span class="gt-bar-track"><span t-att-class="'gt-bar-fill ' + bar.key" t-att-style="'width:' + (bar.count / chartMax * 100) + '%'"/></span><strong t-esc="bar.count"/></button></div><p t-if="!state.data.chart.some(x => x.count)" class="gt-empty">No coverage risks in these buckets for the selected filters.</p></article><aside class="gt-panel gt-guide"><span class="gt-eyebrow">YOUR NEXT ACTION</span><h2>Review, renew, retry.</h2><p>Resolve each required certificate, then retry the normal purchase action. The final gate checks current evidence again.</p><button class="btn gt-review-button" t-on-click="() => this.open('pending')"><i class="fa fa-check-square-o me-2" aria-hidden="true"/><t t-esc="state.data.can_review ? 'Open reviewer queue' : 'View pending statuses'"/></button><p class="gt-restricted"><i class="fa fa-lock me-2" aria-hidden="true"/>Evidence remains restricted to authorized reviewers. This dashboard grants no approval rights.</p></aside></section>
      <section class="gt-panel gt-blocked"><div class="gt-panel-title"><div><h2>Purchase orders needing attention</h2><p>Every remaining line failure is shown, even when only one type matches your filter.</p></div><button class="btn btn-link" t-on-click="() => this.open('blocked')" t-att-disabled="!state.data.can_purchase">View all blocked orders</button></div><div class="gt-table-scroll"><table><thead><tr><th>Purchase order</th><th>Supplier / company</th><th>Current certificate failures</th><th>Next step</th></tr></thead><tbody><tr t-foreach="state.data.blocked" t-as="po" t-key="po.id"><td><button class="gt-record-link" t-on-click="() => this.openRecord('blocked', po.id)" t-esc="po.name"/><span class="gt-status">Blocked</span></td><td><strong t-esc="po.supplier"/><small t-esc="po.company"/></td><td class="gt-reasons" t-esc="po.details"/><td><button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.openRecord('blocked', po.id)">Inspect order</button></td></tr><tr t-if="!state.data.blocked.length"><td colspan="4" class="gt-empty" t-esc="state.data.can_purchase ? 'No currently blocked purchase orders match these filters.' : 'Purchase Order data is unavailable for your role.'"/></tr></tbody></table></div></section>
      <section class="gt-worklists"><article class="gt-panel"><div class="gt-panel-title"><h2>Awaiting verification</h2><button class="btn btn-link" t-on-click="() => this.open('pending')">View all</button></div><ul class="gt-worklist"><li t-foreach="state.data.pending" t-as="item" t-key="item.id"><button t-on-click="() => this.openRecord('pending', item.id)"><span><strong t-esc="item.supplier"/><small t-esc="item.certificate + ' · ' + item.company"/></span><span class="gt-badge">Pending review</span></button></li></ul><p t-if="!state.data.pending.length" class="gt-empty">No submitted documents await review in this scope.</p></article><article class="gt-panel"><div class="gt-panel-title"><h2>Overdue renewal follow-ups</h2><button class="btn btn-link" t-on-click="() => this.open('overdue')">View all</button></div><ul class="gt-worklist"><li t-foreach="state.data.overdue" t-as="item" t-key="item.id"><button t-on-click="() => this.openRecord('overdue', item.id)"><span><strong t-esc="item.supplier + ' · ' + item.certificate"/><small t-esc="item.owner + ' · due ' + item.due_date"/></span><span class="gt-badge gt-overdue">Overdue</span></button></li></ul><p t-if="!state.data.overdue.length" class="gt-empty">No open renewal Activities are overdue.</p></article></section>
    </t>
    <div t-if="state.loading" class="gt-state" role="status"><span class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/><h2>Checking current certificate coverage</h2><p>Applying your permissions, companies and filters.</p></div>
    <div t-if="state.error" class="gt-state gt-error" role="alert"><span class="fa fa-exclamation-triangle" aria-hidden="true"/><h2>Dashboard unavailable</h2><p>The request could not be completed or access changed. No previous totals are shown. Retry, clear filters, or ask your administrator to check access.</p><button class="btn btn-primary" t-on-click="load">Retry</button><button class="btn btn-link" t-on-click="clearFilters">Clear filters</button></div>
    <footer>Golok Technology · Supplier Certificate Gate <span>Verified evidence. Current decisions.</span></footer>
  </main>
</t>
</templates>
